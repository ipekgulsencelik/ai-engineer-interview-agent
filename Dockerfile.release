# Production image reference. Build is optional and never auto-deployed.
# Pin Python base image to a reviewed SHA256 digest before actual production.
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_DEV=1 \
    UV_FROZEN=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# Lock resolution is unchanged; no development dependencies are installed.
RUN python -m pip install --no-cache-dir "uv>=0.9,<1"
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .

# Create a dedicated unprivileged user and writable application-owned data.
RUN groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && chown -R 10001:10001 /app/data

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/', timeout=3).close()" || exit 1

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
