# Production candidate only. Never publish before all release security gates pass.
# Release builds require APPROVED_PYTHON_BASE_IMAGE from the verified
# immutable digest workflow policy. PR CI uses the mutable development default.
# Never promote a PR CI image to production without the release gate.
ARG PYTHON_IMAGE=python:3.11-slim

# Build-only dependency tooling does not enter the deployed container.
FROM ${PYTHON_IMAGE} AS builder

WORKDIR /app

ENV UV_NO_DEV=1 \
    UV_FROZEN=1 \
    UV_LINK_MODE=copy

RUN python -m pip install --no-cache-dir "uv>=0.9,<1"
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# Runtime uses the same Python distribution/ABI, but excludes uv and builders.
FROM ${PYTHON_IMAGE} AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    HOME="/app/data"

COPY --from=builder /app/.venv /app/.venv
COPY . .

# Official Debian 13 security fix for CVE-2026-85091.
# APT validates signed repository metadata and package checksums.
# A vendor fix is a prerequisite, never a substitute for full-image Trivy.
# Build MUST fail if the approved minimum version is not available.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends --only-upgrade zlib1g; \
    installed="$(dpkg-query --show --showformat='${Version}' zlib1g)"; \
    dpkg --compare-versions "$installed" ge "1:1.3.dfsg+really1.3.1-1+deb13u1"; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# Remove interpreter-level packaging tools; application packages are in .venv.
# Application code stays root-owned; only state directory is writable.
RUN /usr/local/bin/python -m pip uninstall --yes pip setuptools wheel \
    && groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/data \
    && chown 10001:10001 /app/data \
    && chmod 0700 /app/data

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/', timeout=3).close()" || exit 1

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
