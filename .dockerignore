# Secrets and local-only environment files
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.p12
*.pfx
*credentials*.json

# Build tool caches / test artifacts / repo administration
.git/
.github/
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.pyright/
htmlcov/
.coverage
dist/
build/
tests/
docs/
ops/

# Persisted local Chroma indices must never ship in a container.
data/chroma/
data/chroma_test/
data/chroma_retrieval_test/
streamlit/

# Locally generated SQLite question vectors, WAL/SHM files and backups.
# The image must be rebuilt from trusted source; never embed state.
data/**/*.sqlite3
data/**/*.sqlite3-*
data/**/*.db
data/**/*.db-*
data/**/*.sqlite3.*
data/**/*.db.*
