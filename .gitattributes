# Never include local caches or database snapshots in published source archives.
data/chroma/ export-ignore
data/chroma_test/ export-ignore
data/chroma_retrieval_test/ export-ignore
*.sqlite3 export-ignore
.env export-ignore
**/.env export-ignore
**/.env.local export-ignore
**/.env.production export-ignore

# Shell scripts and container build files run inside Linux; keep LF on every
# checkout (including Windows with core.autocrlf=true) so bash never sees \r.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
