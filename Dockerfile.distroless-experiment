# EXPERIMENTAL ONLY: ABI/import/security validation, not an approved release image.
# The explicit builder and distroless runtime use Debian 13 with glibc.
# This candidate currently targets linux/amd64; multi-platform needs its own gate.
FROM python:3.11-slim-trixie AS builder

WORKDIR /app
ENV UV_NO_DEV=1 UV_FROZEN=1 UV_LINK_MODE=copy

RUN python -m pip install --no-cache-dir "uv>=0.9,<1"
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY . .

# Remove builder-only tools from the Python installation copied at runtime.
# Keep all application dependencies in /app/.venv, not /usr/local site-packages.
RUN python -m pip uninstall -y pip setuptools wheel \
    && mkdir -p /app/data \
    && chown -R 10001:10001 /app/data \
    && chmod 0700 /app/data

FROM gcr.io/distroless/cc-debian13:nonroot AS runtime

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LD_LIBRARY_PATH="/usr/local/lib" \
    PATH="/app/.venv/bin:/usr/local/bin" \
    HOME="/app/data"

# Copy only CPython interpreter, standard library and application virtualenv.
# Do not copy uv, pip, shell or any mutable local index/snapshot.
COPY --from=builder /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=builder /usr/local/bin/python3 /usr/local/bin/python3
COPY --from=builder /usr/local/bin/python /usr/local/bin/python
COPY --from=builder /usr/local/lib /usr/local/lib
# CPython's _ctypes extension links to libffi.so.8; distroless cc does not bundle it.
# Copy the exact library from the ABI-matched Debian 13 builder, not a broader OS tree.
COPY --from=builder /usr/lib/x86_64-linux-gnu/libffi.so.8 /usr/lib/x86_64-linux-gnu/libffi.so.8
COPY --from=builder /usr/lib/x86_64-linux-gnu/libsqlite3.so.0 \
    /usr/lib/x86_64-linux-gnu/libsqlite3.so.0
COPY --from=builder /app /app
COPY --from=builder --chown=10001:10001 /app/data /app/data

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD ["/usr/local/bin/python3.11", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/', timeout=3).close()"]

ENTRYPOINT ["/app/.venv/bin/python"]
CMD ["-m", "uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
